# -------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL - Railway / Render / Supabase)
# -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@[YOUR_HOST]:5432/[YOUR_DB]?sslmode=require

# -------------------------------------------------------------
# AUTHENTICATION & SECURITY SECRETS
# -------------------------------------------------------------
BETTER_AUTH_SECRET=your_rotated_better_auth_secret_32_chars_min
BETTER_AUTH_URL=https://yourdomain.com
JWT_SECRET=your_rotated_jwt_secret_hex_or_base64
RESET_TOKEN_SECRET=your_rotated_reset_token_secret

# -------------------------------------------------------------
# APPLICATION BASE URLS
# -------------------------------------------------------------
FRONTEND_URL=https://yourdomain.com
PUBLIC_BASE_URL=https://yourdomain.com
VITE_AUTH_ENABLED=true

# -------------------------------------------------------------
# OAUTH PROVIDERS (GOOGLE)
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -------------------------------------------------------------
# META / FACEBOOK GRAPH API CONFIGURATION
# -------------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_LOGIN_CONFIG_ID=

# -------------------------------------------------------------
# SMTP EMAIL CONFIGURATION
# -------------------------------------------------------------
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password

# -------------------------------------------------------------
# AI GENERATION (Provide any one provider: xAI, OpenAI, Groq, or Gemini)
# -------------------------------------------------------------
XAI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

